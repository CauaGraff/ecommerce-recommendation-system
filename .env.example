
# URI do servidor de tracking do MLflow (local ou remoto)
MLFLOW_TRACKING_URI=http://localhost:5000

# Nome do experimento registrado no MLflow
MLFLOW_EXPERIMENT_NAME=ecommerce-recommender

# Tipo de modelo a ser treinado por padrão: "mlp" ou "embedding"
MODEL_TYPE=mlp

# Seed fixada para reprodutibilidade dos experimentos
RANDOM_SEED=42

# Caminhos de dados e artefatos (relativos à raiz do projeto)
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
MODELS_PATH=models
